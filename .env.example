# Banco de dados
DATABASE_URL=postgresql://cardapio:cardapio@localhost:5432/cardapio

# Login do dono (criado pelo seed)
ADMIN_EMAIL=dono@confeitaria.com
ADMIN_PASSWORD=troque-esta-senha

# Segredo para assinar o login (troque por um texto longo e aleatório)
JWT_SECRET=troque-este-segredo

# Mercado Pago (cartão de crédito e débito). Nunca coloque o access token no painel nem no git.
MP_ACCESS_TOKEN=

# Endereço público da API (usado para montar a URL das fotos)
PUBLIC_API_URL=http://localhost:3333

# Endereço público da loja (o Mercado Pago devolve o cliente para cá depois do pagamento)
PUBLIC_WEB_URL=http://localhost:5173
