// Modelo de dados do sistema da confeitaria.
// Valores em dinheiro usam Decimal(10,2); custos unitários de ingredientes usam
// mais casas porque o custo de 1 g de açúcar é uma fração de centavo.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Acesso ──────────────────────────────────────────────────────────────────

model AdminUser {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String   @default("Dono")
  createdAt    DateTime @default(now())
}

// ─── Configurações da loja (registro único, id = 1) ─────────────────────────

model StoreSettings {
  id Int @id @default(1)

  // Identidade
  name          String  @default("Minha Confeitaria")
  description   String?
  logoUrl       String?
  coverUrl      String?
  primaryColor  String  @default("#E85D75")
  whatsappPhone String? // só números, com DDI e DDD: 5516999999999

  // Funcionamento
  isOpen       Boolean   @default(true)
  pausedUntil  DateTime? // pausa temporária
  openingHours Json      @default("[]") // [{ day: 0-6, open: "09:00", close: "18:00" }]

  // Recursos liga/desliga (valores padrão sugeridos no documento de requisitos)
  checkoutEnabled       Boolean @default(true)
  orderTrackingEnabled  Boolean @default(true)
  whatsappNotifications Boolean @default(false)
  whatsappMessages      Json    @default("{}") // { RECEIVED: "...", PREPARING: "..." }
  stockControlEnabled   Boolean @default(false)
  couponsEnabled        Boolean @default(false)
  reviewsEnabled        Boolean @default(false)

  // Retirada
  pickupEnabled Boolean @default(true)
  pickupAddress String?

  // Entrega
  deliveryEnabled   Boolean  @default(false)
  deliveryFeeMode   FeeMode  @default(BY_NEIGHBORHOOD)
  deliveryFeePerKm  Decimal? @db.Decimal(10, 2)
  deliveryMaxKm     Decimal? @db.Decimal(6, 2)
  minimumOrderValue Decimal? @db.Decimal(10, 2)

  // Encomendas
  preOrdersEnabled   Boolean @default(false)
  preOrderMinHours   Int     @default(24)
  preOrderDailyLimit Int?

  // Pagamentos: Pix pela chave da loja; crédito e débito pelo Mercado Pago.
  // O access token do Mercado Pago fica só no .env (MP_ACCESS_TOKEN), nunca aqui.
  pixEnabled      Boolean     @default(true)
  pixKey          String?
  pixKeyType      PixKeyType?
  pixReceiverName String? // nome que aparece no Pix (até 25 caracteres)
  pixCity         String? // cidade do recebedor (até 15 caracteres)
  creditEnabled   Boolean     @default(false)
  debitEnabled    Boolean     @default(false)
  mpPublicKey     String? // chave pública do Mercado Pago (pode ficar no front)
  cashEnabled     Boolean     @default(false)

  updatedAt DateTime @updatedAt
}

enum FeeMode {
  BY_NEIGHBORHOOD
  BY_KM
}

enum PixKeyType {
  CPF
  CNPJ
  EMAIL
  PHONE
  RANDOM
}

model DeliveryZone {
  id           String  @id @default(cuid())
  neighborhood String  @unique
  fee          Decimal @db.Decimal(10, 2)
  active       Boolean @default(true)
}

// ─── Cardápio ────────────────────────────────────────────────────────────────

model Category {
  id        String    @id @default(cuid())
  name      String
  sortOrder Int       @default(0)
  active    Boolean   @default(true)
  products  Product[]
}

model Product {
  id          String   @id @default(cuid())
  categoryId  String
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  name        String
  description String?
  imageUrl    String?
  price       Decimal  @db.Decimal(10, 2)
  promoPrice  Decimal? @db.Decimal(10, 2)
  available   Boolean  @default(true) // chave manual do dono
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  variations  ProductVariation[]
  addonGroups ProductAddonGroup[]
  recipe      Recipe?
  orderItems  OrderItem[]
}

// Variação (tamanho, sabor). O preço da variação substitui o preço do produto.
model ProductVariation {
  id         String      @id @default(cuid())
  productId  String
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String // "Fatia", "Inteiro 1 kg", "Chocolate"
  price      Decimal     @db.Decimal(10, 2)
  available  Boolean     @default(true)
  sortOrder  Int         @default(0)
  recipe     Recipe?
  orderItems OrderItem[]
}

// Grupo de adicionais reutilizável ("Coberturas", "Velas").
model AddonGroup {
  id        String              @id @default(cuid())
  name      String
  minSelect Int                 @default(0)
  maxSelect Int                 @default(1)
  addons    Addon[]
  products  ProductAddonGroup[]
}

model Addon {
  id              String           @id @default(cuid())
  groupId         String
  group           AddonGroup       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name            String
  price           Decimal          @default(0) @db.Decimal(10, 2)
  available       Boolean          @default(true)
  sortOrder       Int              @default(0)
  orderItemAddons OrderItemAddon[]
}

model ProductAddonGroup {
  productId String
  groupId   String
  sortOrder Int        @default(0)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  group     AddonGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  @@id([productId, groupId])
}

// ─── Estoque ─────────────────────────────────────────────────────────────────

// Unidade base em que o item é contado e custeado. Compras em kg ou L são
// convertidas para g ou ml na entrada.
enum StockUnit {
  G
  ML
  UN
}

enum StockItemKind {
  INGREDIENT
  PACKAGING
}

model StockItem {
  id        String        @id @default(cuid())
  name      String        @unique
  kind      StockItemKind @default(INGREDIENT)
  unit      StockUnit
  quantity  Decimal       @default(0) @db.Decimal(12, 3) // quantidade atual, na unidade base
  unitCost  Decimal       @default(0) @db.Decimal(12, 6) // R$ por unidade base (preço da última compra)
  minimum   Decimal       @default(0) @db.Decimal(12, 3) // estoque mínimo, dispara alerta
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  movements   StockMovement[]
  recipeItems RecipeItem[]
}

enum MovementType {
  PURCHASE // entrada por compra (atualiza o custo)
  ORDER // baixa automática por pedido confirmado
  ADJUSTMENT // ajuste manual (perda, contagem)
}

model StockMovement {
  id          String       @id @default(cuid())
  stockItemId String
  stockItem   StockItem    @relation(fields: [stockItemId], references: [id], onDelete: Cascade)
  type        MovementType
  quantity    Decimal      @db.Decimal(12, 3) // positivo = entrada, negativo = saída
  totalCost   Decimal?     @db.Decimal(10, 2) // valor pago na compra
  note        String?
  orderId     String?
  order       Order?       @relation(fields: [orderId], references: [id], onDelete: SetNull)
  createdAt   DateTime     @default(now())

  @@index([stockItemId, createdAt])
}

// ─── Ficha técnica e precificação ────────────────────────────────────────────

// Uma receita pertence a um produto OU a uma variação.
model Recipe {
  id          String            @id @default(cuid())
  productId   String?           @unique
  product     Product?          @relation(fields: [productId], references: [id], onDelete: Cascade)
  variationId String?           @unique
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: Cascade)

  yieldQuantity Decimal @db.Decimal(10, 2) // quantas unidades a receita rende
  targetMargin  Decimal @default(0.30) @db.Decimal(5, 4) // margem desejada sobre o preço de venda (0.30 = 30%)

  // Custos indiretos (opcionais)
  packagingCostPerUnit Decimal @default(0) @db.Decimal(10, 2) // R$ por unidade vendida
  energyCost           Decimal @default(0) @db.Decimal(10, 2) // gás/energia, R$ por receita
  laborCost            Decimal @default(0) @db.Decimal(10, 2) // mão de obra, R$ por receita
  appFeePercent        Decimal @default(0) @db.Decimal(5, 4) // taxa do app de delivery, % do preço (0.12 = 12%)

  notes     String?
  updatedAt DateTime @updatedAt

  items RecipeItem[]
}

model RecipeItem {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  stockItemId String
  stockItem   StockItem @relation(fields: [stockItemId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(12, 3) // na unidade base do item de estoque

  @@unique([recipeId, stockItemId])
}

// ─── Pedidos ─────────────────────────────────────────────────────────────────

enum OrderStatus {
  RECEIVED
  PREPARING
  OUT_FOR_DELIVERY
  READY_FOR_PICKUP
  DELIVERED
  CANCELED
}

enum FulfillmentType {
  PICKUP
  DELIVERY
}

enum PaymentMethod {
  PIX
  CREDIT_CARD
  DEBIT_CARD
  CASH
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Order {
  id            String          @id @default(cuid())
  number        Int             @unique @default(autoincrement()) // número curto para o cliente
  publicToken   String          @unique @default(cuid()) // link de acompanhamento
  status        OrderStatus     @default(RECEIVED)
  fulfillment   FulfillmentType
  scheduledFor  DateTime? // encomenda para data futura
  customerName  String
  customerPhone String
  address       Json? // { street, number, complement, neighborhood, reference }
  subtotal      Decimal         @db.Decimal(10, 2)
  deliveryFee   Decimal         @default(0) @db.Decimal(10, 2)
  discount      Decimal         @default(0) @db.Decimal(10, 2)
  total         Decimal         @db.Decimal(10, 2)
  couponCode    String?
  notes         String?

  paymentMethod PaymentMethod
  paymentStatus PaymentStatus @default(PENDING)
  changeFor     Decimal?      @db.Decimal(10, 2) // troco para (dinheiro)
  mpPaymentId   String? // id do pagamento no Mercado Pago

  stockDeducted Boolean  @default(false) // evita baixar o estoque duas vezes
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  items          OrderItem[]
  statusHistory  OrderStatusHistory[]
  stockMovements StockMovement[]
  review         Review?

  @@index([status, createdAt])
}

model OrderItem {
  id          String            @id @default(cuid())
  orderId     String
  order       Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String?
  product     Product?          @relation(fields: [productId], references: [id], onDelete: SetNull)
  variationId String?
  variation   ProductVariation? @relation(fields: [variationId], references: [id], onDelete: SetNull)
  // Cópia dos dados no momento da venda, para o histórico não mudar se o cardápio mudar
  name        String
  unitPrice   Decimal           @db.Decimal(10, 2)
  quantity    Int
  notes       String?
  addons      OrderItemAddon[]
}

model OrderItemAddon {
  id          String    @id @default(cuid())
  orderItemId String
  orderItem   OrderItem @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  addonId     String?
  addon       Addon?    @relation(fields: [addonId], references: [id], onDelete: SetNull)
  name        String
  price       Decimal   @db.Decimal(10, 2)
}

model OrderStatusHistory {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status    OrderStatus
  createdAt DateTime    @default(now())
}

// ─── Cupons e avaliações ─────────────────────────────────────────────────────

enum DiscountType {
  PERCENT
  FIXED
}

model Coupon {
  id           String       @id @default(cuid())
  code         String       @unique
  type         DiscountType
  value        Decimal      @db.Decimal(10, 2)
  minimumOrder Decimal?     @db.Decimal(10, 2)
  validUntil   DateTime?
  maxUses      Int?
  usedCount    Int          @default(0)
  active       Boolean      @default(true)
}

model Review {
  id        String   @id @default(cuid())
  orderId   String   @unique
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rating    Int // 1 a 5
  comment   String?
  createdAt DateTime @default(now())
}
